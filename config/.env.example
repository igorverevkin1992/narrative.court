# ============================================================
# The Narrative Court - secrets template.
# Copy this file to config/.env and fill in the values.
# config/.env is gitignored and MUST NEVER be committed.
#
# Storage policy (see modules.config loader):
#   1. Primary: OS keyring (Keychain / Credential Manager / SecretService),
#      written through the in-app onboarding wizard.
#   2. Fallback: this .env file, loaded by python-dotenv when keyring
#      has no entry for a given key.
# ============================================================

# ---------- Season 1 ----------
OPENAI_API_KEY=            # GPT-5.5
XAI_API_KEY=              # Grok 4.3
ANTHROPIC_API_KEY=        # Claude Opus 4.8
GOOGLE_API_KEY=           # Gemini 3.1 Pro (also used by the translation corrector)
DEEPSEEK_API_KEY=         # DeepSeek V4 (deepseek-v4-pro / deepseek-v4-flash ONLY)
DASHSCOPE_API_KEY=        # Alibaba Qwen 3.7 Max (DashScope)
MISTRAL_API_KEY=          # Mistral Large 3

# ---------- Season 2 ----------
# GigaChat Ultra - [SANCTIONS RISK - legal review required, INA §329]
GIGACHAT_AUTH_KEY=        # base64(client_id:client_secret) for the OAuth token exchange
GIGACHAT_SCOPE=GIGACHAT_API_PERS
YANDEX_API_KEY=           # YandexGPT 5.1 Pro (Yandex Cloud API key / IAM token)
YANDEX_FOLDER_ID=         # Yandex Cloud folder id (x-folder-id)
ZHIPU_API_KEY=            # Zhipu GLM-5.2
FALCON_API_KEY=           # Falcon-H1 34B (TII API or HuggingFace Inference)
HYPERCLOVA_API_KEY=       # Naver HyperCLOVA X
HYPERCLOVA_APIGW_KEY=     # Naver API gateway key
SARVAM_API_KEY=           # Sarvam 105B
AI21_API_KEY=             # AI21 Jamba
OPENROUTER_API_KEY=       # Rakuten AI 3.0 (served via OpenRouter)

# ---------- TTS ----------
ELEVENLABS_API_KEY=       # ElevenLabs (Pro plan required for 44.1 kHz+ WAV/PCM)
